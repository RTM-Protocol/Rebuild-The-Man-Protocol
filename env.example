# Supabase Configuration
# Copy this file to .env.local and fill in your values

# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only — used by the account deletion route to bypass Row-Level
# Security. NEVER expose this to the browser.
# Get from: https://app.supabase.com/project/_/settings/api  (service_role key)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Landing site origin. Purchasing happens there, not in this app — every
# "Get Lifetime Access" button links out to it. Point this at a local
# landing server (e.g. http://localhost:3001) to test the hand-off.
NEXT_PUBLIC_SITE_URL=https://rebuildthemanprotocol.com

# Public base URL of THIS app, used for OAuth and password-reset redirects.
# Use http://localhost:3000 for local dev.
NEXT_PUBLIC_BASE_URL=https://rebuildthemanprotocol.com











