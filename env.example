# Supabase Configuration
# Copy this file to .env.local and fill in your values

# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only — used by the Stripe webhook + account deletion routes to
# bypass Row-Level Security. NEVER expose this to the browser.
# Get from: https://app.supabase.com/project/_/settings/api  (service_role key)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe Configuration
# Get from: https://dashboard.stripe.com/apikeys
# Use sk_test_/pk_test_ keys while testing, then swap for sk_live_/pk_live_.
STRIPE_SECRET_KEY=sk_live_your_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here

# Get from: https://dashboard.stripe.com/webhooks  (after creating the endpoint)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Public base URL used to build Stripe success/cancel URLs and OAuth redirects.
# Use http://localhost:3000 for local dev.
NEXT_PUBLIC_BASE_URL=https://rebuildthemanprotocol.com











